<%- include('partials/head') %>
<div class="page-head">
  <div class="page-head-text">
    <h1>Leave of absence</h1>
    <p>Staff request leave with <code>/loa request</code> in Discord or the form below. Once approved, the bot adds the LOA role on the first day and removes it after the last day.</p>
  </div>
</div>

<% if (isManager && (!loaRoleSet || !loaChannelSet)) { %>
  <div class="flash flash-error"><%- include('partials/icon', { name: 'alert' }) %><span><%= !loaRoleSet ? 'No LOA role is set, so approved leave won\'t change roles. ' : '' %><%= !loaChannelSet ? 'No LOA channel is set, so requests only show here. ' : '' %>Set them in Settings → Staff management.</span></div>
<% } %>

<% const card = (l, actions) => { %>
  <li class="row">
    <span class="row-main" style="flex: 1;">
      <span class="role-icon"><%= l.user_tag.slice(0, 1).toUpperCase() %></span>
      <span><strong><%= l.user_tag %></strong> <span class="pill <%= { 'On leave': 'pill-pending', Upcoming: 'pill-open', Pending: 'pill-pending', Denied: 'pill-denied' }[l.label] || 'pill-off' %>"><%= l.label %></span><br>
        <span class="muted small"><%= l.from %> → <%= l.until %><%= l.reason ? ' · ' + l.reason : '' %></span></span>
    </span>
    <% if (actions && isManager) { %>
      <span class="row-actions">
        <% actions.forEach(([a, label, cls]) => { %>
          <form method="post" action="/loa/<%= l.id %>/<%= a %>"<% if (a === 'end') { %> data-confirm="End <%= l.user_tag %>'s LOA now?"<% } %>>
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-sm <%= cls %>" type="submit"><%= label %></button>
          </form>
        <% }) %>
      </span>
    <% } %>
  </li>
<% } %>

<% if (isManager) { %>
<section class="card">
  <div class="card-head"><h2>Waiting for approval</h2><span class="muted small"><%= pending.length %></span></div>
  <% if (!pending.length) { %><p class="empty-row">Nothing to review.</p><% } else { %>
    <ul class="rows"><% pending.forEach(l => card(l, [['approve', 'Approve', 'btn-success'], ['deny', 'Deny', 'btn-danger-ghost']])) %></ul>
  <% } %>
</section>
<% } %>

<section class="card">
  <div class="card-head"><h2>On leave and upcoming</h2><span class="muted small"><%= current.length %></span></div>
  <% if (!current.length) { %><p class="empty-row">Nobody is on leave.</p><% } else { %>
    <ul class="rows"><% current.forEach(l => card(l, [['end', 'End now', 'btn-ghost']])) %></ul>
  <% } %>
</section>

<section class="card">
  <h2>Request leave</h2>
  <form method="post" action="/loa">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid-3">
      <div class="field"><label for="start_date">First day away</label><input type="date" id="start_date" name="start_date" min="<%= today %>" required></div>
      <div class="field"><label for="end_date">Last day away</label><input type="date" id="end_date" name="end_date" min="<%= today %>" required></div>
      <div class="field"><label for="loa-reason">Reason (optional)</label><input id="loa-reason" name="reason" maxlength="500"></div>
    </div>
    <button class="btn btn-primary" type="submit"><%- include('partials/icon', { name: 'calendar', size: 16 }) %> Send request</button>
  </form>
</section>

<section class="card">
  <h2>History</h2>
  <% if (!past.length) { %><p class="empty-row">No past leave yet.</p><% } else { %>
    <ul class="rows"><% past.forEach(l => card(l, null)) %></ul>
  <% } %>
</section>
<%- include('partials/foot') %>
