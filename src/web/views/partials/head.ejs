<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Orbit</title>
  <link rel="icon" type="image/png" href="/static/orbit-logo.png">
  <meta name="theme-color" content="#05070C">
  <link rel="stylesheet" href="/static/style.css?v=<%= assetVersion %>">
  <script src="/static/app.js?v=<%= assetVersion %>" defer></script>
  <script>document.documentElement.classList.add('js')</script>
</head>
<body class="<%= user ? 'has-sidebar' : 'no-sidebar' %>">
<% if (user) {
  const nc = typeof navCounts !== 'undefined' && navCounts ? navCounts : {};
  const admin = typeof isAdmin !== 'undefined' && isAdmin;
  const manager = typeof isManager !== 'undefined' && isManager;
  const links = [
    { href: '/', label: 'Overview', icon: 'home', active: path === '/' },
    { section: 'Review' },
    { href: '/submissions', label: 'Submissions', icon: 'inbox', active: path.startsWith('/submissions'), count: nc.pending, countLabel: 'pending' },
    { href: '/tickets', label: 'Tickets', icon: 'ticket', active: path.startsWith('/tickets') && !path.startsWith('/ticket-types'), count: nc.open_tickets, countLabel: 'open' },
    { section: 'Staff' },
    { href: '/staff', label: 'Activity', icon: 'chart', active: path.startsWith('/staff') },
    { href: '/loa', label: 'Leave (LOA)', icon: 'calendar', active: path.startsWith('/loa'), count: manager ? nc.pending_loa : 0, countLabel: 'pending' },
  ];
  if (manager) links.push({ href: '/strikes', label: 'Strikes', icon: 'alert', active: path.startsWith('/strikes') });
  if (admin || manager) links.push({ section: 'Community' });
  if (admin) links.push({ href: '/welcome', label: 'Welcome', icon: 'wave', active: path.startsWith('/welcome') });
  if (manager) links.push({ href: '/giveaways', label: 'Giveaways', icon: 'gift', active: path.startsWith('/giveaways') });
  if (manager) links.push({ href: '/polls', label: 'Polls', icon: 'poll', active: path.startsWith('/polls') });
  if (admin || manager) links.push({ section: 'Setup' });
  if (admin) links.push({ href: '/applications', label: 'Applications', icon: 'list', active: path.startsWith('/applications') });
  if (manager) links.push({ href: '/ticket-types', label: 'Ticket types', icon: 'ticket', active: path.startsWith('/ticket-types') });
  if (admin) links.push({ href: '/settings', label: 'Settings', icon: 'settings', active: path.startsWith('/settings') });
%>
<aside class="sidebar">
  <a class="brand" href="/">
    <img class="brand-logo" src="/static/orbit-logo.png" alt="" width="40" height="40">
    <span class="brand-text">
      <span class="brand-name">Orbit</span>
      <span class="brand-sub">BloxVerse Staff Hub</span>
    </span>
  </a>
  <nav class="side-nav" aria-label="Main">
    <% links.forEach(l => { if (l.section) { %>
      <div class="side-section"><%= l.section %></div>
    <% } else { %>
      <a href="<%= l.href %>" class="side-link <%= l.active ? 'active' : '' %>" <%= l.active ? 'aria-current=page' : '' %>>
        <%- include('icon', { name: l.icon }) %>
        <span class="side-label"><%= l.label %></span>
        <% if (l.count) { %><span class="side-count" title="<%= l.count %> <%= l.countLabel %>"><%= l.count %><span class="sr"> <%= l.countLabel %></span></span><% } %>
      </a>
    <% } }) %>
  </nav>
  <div class="side-user">
    <% if (user.avatar) { %><img src="<%= user.avatar %>" alt="" width="32" height="32"><% } else { %><span class="avatar-fallback" aria-hidden="true"><%= (user.name || '?').slice(0, 1).toUpperCase() %></span><% } %>
    <span class="side-user-text">
      <span class="side-user-name"><%= user.name %></span>
      <span class="side-user-role"><%= admin ? 'Admin' : manager ? 'Manager' : 'Staff' %></span>
    </span>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="icon-btn" type="submit" aria-label="Sign out" title="Sign out"><%- include('icon', { name: 'logout' }) %></button>
    </form>
  </div>
</aside>
<% } %>
<main class="page">
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>" role="status">
    <%- include('icon', { name: flash.type === 'success' ? 'check' : 'alert' }) %>
    <span><%= flash.text %></span>
  </div>
<% } %>
