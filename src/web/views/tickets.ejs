<%- include('partials/head') %>
<div class="page-head">
  <div class="page-head-text">
    <h1>Tickets</h1>
    <p>Every ticket opened in the server, with full transcripts.</p>
  </div>
</div>

<div class="toolbar">
  <form method="get" action="/tickets" class="filters">
    <div class="tabs" role="group" aria-label="Filter by status">
      <% [['', 'All'], ['open', 'Open'], ['closed', 'Closed']].forEach(([v, l]) => { %>
        <a class="tab <%= status === v ? 'active' : '' %>" href="/tickets?status=<%= v %><%= search ? '&q=' + encodeURIComponent(search) : '' %>"><%= l %></a>
      <% }) %>
    </div>
    <input type="hidden" name="status" value="<%= status %>">
    <div class="search">
      <%- include('partials/icon', { name: 'search', size: 16 }) %>
      <label class="sr" for="q">Search by username or topic</label>
      <input id="q" name="q" value="<%= search %>" placeholder="Search username or topic">
    </div>
  </form>
</div>

<section class="card flush">
  <% if (!tickets.length) { %>
    <p class="muted pad">No tickets match.</p>
  <% } else { %>
  <form method="post" action="/tickets/delete" data-bulk data-confirm-bulk="Delete {n} ticket(s) and their transcripts? Open tickets are skipped. This can't be undone.">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="back" value="<%= path %>?status=<%= status %>&q=<%= encodeURIComponent(search) %>">
    <% if (isAdmin) { %>
    <div class="bulk-bar">
      <span class="muted" data-bulk-count>Select closed tickets to delete them</span>
      <button class="btn btn-danger btn-sm" type="submit" data-bulk-submit disabled><%- include('partials/icon', { name: 'trash', size: 16 }) %> Delete selected</button>
    </div>
    <% } %>
    <div class="table-wrap">
      <table>
        <thead><tr>
          <% if (isAdmin) { %><th class="check-col"><label class="sr" for="select-all">Select all closed tickets</label><input type="checkbox" id="select-all" data-select-all></th><% } %>
          <th>Ticket</th><th>Opened by</th><th>Topic</th><th>Status</th><th>Messages</th><th>Opened</th>
        </tr></thead>
        <tbody>
          <% tickets.forEach(t => { const num = String(t.number).padStart(4, '0'); %>
            <tr>
              <% if (isAdmin) { %><td class="check-col">
                <% if (t.status === 'closed') { %><label class="sr" for="sel-<%= t.id %>">Select ticket <%= num %></label><input type="checkbox" id="sel-<%= t.id %>" name="ids" value="<%= t.id %>" data-row-check><% } %>
              </td><% } %>
              <td><a class="cell-link" href="/tickets/<%= t.id %>">#<%= num %></a></td>
              <td><%= t.opener_tag %></td>
              <td class="clip muted"><%= t.topic %></td>
              <td><%- include('partials/status', { status: t.status }) %></td>
              <td class="muted"><%= t.message_count %></td>
              <td class="muted"><time datetime="<%= new Date(t.created_at).toISOString() %>"></time></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </form>
  <% } %>
</section>

<nav class="pager" aria-label="Pages">
  <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="?status=<%= status %>&q=<%= encodeURIComponent(search) %>&page=<%= page - 1 %>">Newer</a><% } %>
  <% if (hasMore) { %><a class="btn btn-ghost btn-sm" href="?status=<%= status %>&q=<%= encodeURIComponent(search) %>&page=<%= page + 1 %>">Older</a><% } %>
</nav>
<%- include('partials/foot') %>
