<%- include('partials/head') %>
<div class="page-head">
  <div class="page-head-text">
    <h1>Staff activity</h1>
    <p>Who's reviewing applications and handling tickets. Ratings come from members rating tickets the staff member claimed.</p>
  </div>
  <div class="tabs" role="group" aria-label="Time period">
    <% [['7', 'Last 7 days'], ['30', 'Last 30 days'], ['all', 'All time']].forEach(([v, l]) => { %>
      <a class="tab <%= period === v ? 'active' : '' %>" href="/staff?period=<%= v %>"><%= l %></a>
    <% }) %>
  </div>
</div>

<% const onlineCount = table.filter(r => r.online && r.online.status !== 'offline').length; const staffCount = table.filter(r => r.online).length; %>
<% if (!presenceOn) { %>
  <div class="flash flash-info"><%- include('partials/icon', { name: 'alert' }) %><span>Online status is hidden. Turn on <strong>Presence Intent</strong> in the Discord Developer Portal (Orbit → Bot), then restart the bot.</span></div>
<% } else if (staffCount) { %>
  <p class="presence-summary"><span class="presence-dot is-<%= onlineCount ? 'online' : 'offline' %>" aria-hidden="true"></span><strong><%= onlineCount %></strong> of <%= staffCount %> staff online right now</p>
<% } %>
<% if (noStaffRole) { %>
  <div class="flash flash-error"><%- include('partials/icon', { name: 'alert' }) %><span>No staff role is set, so only people with recorded activity are listed. Pick one in Settings.</span></div>
<% } else if (!membersLoaded) { %>
  <div class="flash flash-error"><%- include('partials/icon', { name: 'alert' }) %><span>The bot can't see the member list yet. Turn on Server Members Intent in the Discord Developer Portal.</span></div>
<% } %>

<section class="stats">
  <div class="stat"><span class="stat-icon"><%- include('partials/icon', { name: 'inbox', size: 20 }) %></span><span class="stat-text"><span class="stat-num"><%= totals.reviews %></span><span class="stat-label">Applications reviewed</span></span></div>
  <div class="stat"><span class="stat-icon green"><%- include('partials/icon', { name: 'ticket', size: 20 }) %></span><span class="stat-text"><span class="stat-num"><%= totals.claimed %></span><span class="stat-label">Tickets claimed</span></span></div>
  <div class="stat"><span class="stat-icon"><%- include('partials/icon', { name: 'user', size: 20 }) %></span><span class="stat-text"><span class="stat-num"><%= totals.interviews %></span><span class="stat-label">Interviews</span></span></div>
  <div class="stat"><span class="stat-icon warn"><%- include('partials/icon', { name: 'check', size: 20 }) %></span><span class="stat-text"><span class="stat-num"><%= totals.votes %></span><span class="stat-label">Votes cast</span></span></div>
</section>

<section class="card flush">
  <% if (!table.length) { %>
    <p class="muted pad">No staff activity yet.</p>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr>
        <th>Staff member</th><th class="num">Reviewed</th><th class="num">Votes</th><th class="num">Interviews</th>
        <th class="num">Claimed</th><th class="num">Closed</th><th class="num">Rating</th><th class="num">Strikes</th><th>Status</th>
      </tr></thead>
      <tbody>
        <% table.forEach(r => { %>
          <tr>
            <td>
              <span class="row-main"><span class="role-icon presence-wrap"><%= (((r.name || '').match(/[\p{L}\p{N}]/u) || ['?'])[0]).toUpperCase() %><% if (presenceOn && r.online) { %><span class="presence-dot is-<%= r.online.status %>" title="<%= r.online.label %>"></span><% } %></span>
                <span><strong><%= r.name %></strong><% if (r.isOwner) { %> <span class="owner-tag">Owner</span><% } %>
                  <% if (!r.isStaffMember) { %><br><span class="muted small">No longer staff</span>
                  <% } else if (presenceOn && r.online) { %><br><span class="muted small presence-text"><%= r.online.label %><% if (r.online.lastSeen) { %> · last seen <time datetime="<%= r.online.lastSeen.toISOString() %>"></time><% } %></span><% } %>
                </span></span>
            </td>
            <td class="num"><%= r.reviews %><% if (r.reviews) { %> <span class="muted small">(<%= r.accepted %>✓ <%= r.denied %>✗)</span><% } %></td>
            <td class="num"><%= r.votes %></td>
            <td class="num"><%= r.interviews %></td>
            <td class="num"><%= r.claimed %></td>
            <td class="num"><%= r.closed %></td>
            <td class="num"><% if (r.avgRating) { %><span class="rating"><%- include('partials/icon', { name: 'star', size: 14 }) %> <%= r.avgRating %></span> <span class="muted small">(<%= r.ratings %>)</span><% } else { %><span class="muted">—</span><% } %></td>
            <td class="num"><% if (r.strikes) { %><span class="pill pill-denied"><%= r.strikes %></span><% } else { %><span class="muted">0</span><% } %></td>
            <td><% if (r.loa) { %><span class="pill pill-pending"><%= r.loa %></span><% } else if (r.score === 0) { %><span class="pill pill-off">No activity</span><% } else { %><span class="pill pill-open">Active</span><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<% if (isManager) { const hourLabel = (h) => `${((h + 11) % 12) + 1}:00 ${h < 12 ? 'AM' : 'PM'}`; %>
<section class="card" id="report">
  <div class="card-head">
    <div>
      <h2 style="margin: 0;">Weekly staff report</h2>
      <span class="muted small">Posts each person's applications, tickets, mod actions<%= presenceOn ? ' and time online' : '' %> for the last 7 days, and flags anyone inactive who isn't on leave.</span>
    </div>
    <% if (report.last) { %><span class="muted small">Last posted <%= report.last %></span><% } %>
  </div>
  <form method="post" action="/staff/report" class="stack" style="gap: 12px;">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="report-grid">
      <%- include('partials/select', { name: 'staff_report_channel_id', label: 'Channel', list: textChannels, value: report.channelId, emptyLabel: 'Off (no report)' }) %>
      <div class="field">
        <label for="staff_report_day">Day</label>
        <select id="staff_report_day" name="staff_report_day"><% dayNames.forEach((d, i) => { %><option value="<%= i %>" <%= i === report.day ? 'selected' : '' %>><%= d %></option><% }) %></select>
      </div>
      <div class="field">
        <label for="staff_report_hour">Time</label>
        <select id="staff_report_hour" name="staff_report_hour"><% for (let h = 0; h < 24; h++) { %><option value="<%= h %>" <%= h === report.hour ? 'selected' : '' %>><%= hourLabel(h) %></option><% } %></select>
        <p class="help"><%= timezone %></p>
      </div>
    </div>
    <div class="tab-actions">
      <button class="btn btn-primary" type="submit"><%- include('partials/icon', { name: 'check', size: 16 }) %> Save</button>
      <button class="btn" type="submit" formaction="/staff/report/send" <%= report.channelId ? '' : 'disabled' %>><%- include('partials/icon', { name: 'send', size: 16 }) %> Post a report now</button>
    </div>
  </form>
</section>
<% } %>
<%- include('partials/foot') %>
