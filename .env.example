# Copy this file to .env for local testing. On Railway, add these as Variables instead.
# Never commit your real .env or share these values.

# From the Discord Developer Portal > your application
DISCORD_TOKEN=           # Bot tab > Reset Token
DISCORD_CLIENT_ID=       # OAuth2 tab > Client ID
DISCORD_CLIENT_SECRET=   # OAuth2 tab > Client Secret

# Your server's ID (Discord: Settings > Advanced > Developer Mode, then right-click the server > Copy Server ID)
GUILD_ID=

# Postgres connection string. Railway fills this in when you add a Postgres database.
DATABASE_URL=postgres://user:password@localhost:5432/appbot
# Set to true only if your database requires SSL from outside its network
DATABASE_SSL=false

# The website's public address, no trailing slash (e.g. https://app-bot-production.up.railway.app)
PUBLIC_URL=http://localhost:3000

# Optional. Signs website login cookies. Leave blank and the app makes one for itself.
SESSION_SECRET=

# Railway sets PORT automatically
PORT=3000
