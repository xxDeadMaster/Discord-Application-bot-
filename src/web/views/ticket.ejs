<%- include('partials/head') %>
<div class="page-head">
  <div class="page-head-text">
    <a class="crumbs" href="/tickets"><%- include('partials/icon', { name: 'arrowLeft', size: 14 }) %> Tickets</a>
    <h1><%= title %></h1>
  </div>
  <%- include('partials/status', { status: ticket.status }) %>
</div>

<div class="detail">
  <section class="card">
    <div class="card-head">
      <h2>Transcript</h2>
      <a class="btn btn-ghost btn-sm" href="/tickets/<%= ticket.id %>/transcript.txt"><%- include('partials/icon', { name: 'download', size: 16 }) %> Download .txt</a>
    </div>
    <% if (!messages.length) { %>
      <p class="muted" style="margin: 0;">No messages recorded.</p>
    <% } else { %>
      <ol class="transcript">
        <% messages.forEach(m => { %>
          <li class="<%= m.is_bot ? 'bot' : '' %>">
            <span class="t-avatar" aria-hidden="true"><%= m.author_tag.slice(0, 1).toUpperCase() %></span>
            <div class="t-content">
              <div class="t-head">
                <strong><%= m.author_tag %></strong>
                <% if (m.is_bot) { %><span class="pill pill-bot">Bot</span><% } %>
                <time datetime="<%= new Date(m.created_at).toISOString() %>"></time>
              </div>
              <% if (m.content) { %><p class="t-body"><%= m.content %></p><% } %>
              <% (m.attachments || []).forEach(a => { %>
                <a class="t-attach" href="<%= a.url %>" target="_blank" rel="noopener noreferrer"><%- include('partials/icon', { name: 'external', size: 14 }) %> <%= a.name %></a>
              <% }) %>
            </div>
          </li>
        <% }) %>
      </ol>
      <p class="help">Attachment links come from Discord and can stop working after a while.</p>
    <% } %>
  </section>

  <aside class="stack">
    <section class="card">
      <dl class="meta meta-col">
        <div><dt>Opened by</dt><dd><strong><%= ticket.opener_tag %></strong><br><span class="muted small">ID <%= ticket.opener_id %></span></dd></div>
        <% if (ticket.type_name) { %><div><dt>Type</dt><dd><%= ticket.type_name %></dd></div><% } %>
        <% const ans = Array.isArray(ticket.answers) && ticket.answers.length ? ticket.answers : [{ q: 'Topic', a: ticket.topic }]; ans.forEach(x => { %>
          <div><dt><%= x.q %></dt><dd style="white-space: pre-wrap;"><%= x.a || '—' %></dd></div>
        <% }) %>
        <div><dt>Claimed by</dt><dd><%= ticket.claimed_by_tag || 'Nobody' %></dd></div>
        <div><dt>Rating</dt><dd><% if (ticket.rating) { %><span class="rating"><%- include('partials/icon', { name: 'star', size: 15 }) %> <%= ticket.rating %>/5</span><% } else { %><span class="muted"><%= ticket.status === 'open' ? 'Asked when it closes' : 'Not rated' %></span><% } %></dd></div>
        <div><dt>Opened</dt><dd><time datetime="<%= new Date(ticket.created_at).toISOString() %>"></time></dd></div>
        <% if (ticket.closed_at) { %>
          <div><dt>Closed</dt><dd><time datetime="<%= new Date(ticket.closed_at).toISOString() %>"></time><br><span class="muted small">by <%= ticket.closed_by_tag || 'unknown' %></span></dd></div>
        <% } %>
      </dl>
      <% if (ticket.status === 'open') { %>
        <form method="post" action="/tickets/<%= ticket.id %>/claim" style="margin-top: 18px;">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn <%= ticket.claimed_by === user.id ? 'btn-ghost' : 'btn-primary' %>" type="submit"><%- include('partials/icon', { name: 'hand', size: 16 }) %> <%= ticket.claimed_by === user.id ? 'Unclaim' : ticket.claimed_by ? 'Take over' : 'Claim' %></button>
        </form>
        <form method="post" action="/tickets/<%= ticket.id %>/close" data-confirm="Close this ticket? The channel will be deleted and the transcript saved." style="margin-top: 10px;">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-danger" type="submit"><%- include('partials/icon', { name: 'x', size: 16 }) %> Close ticket</button>
        </form>
      <% } %>
    </section>

    <% if (isAdmin && ticket.status === 'closed') { %>
    <section class="card danger-zone">
      <h2>Delete ticket</h2>
      <p class="muted small">Removes the ticket and its transcript from the dashboard. The copy posted in your log channel stays. This can't be undone.</p>
      <form method="post" action="/tickets/<%= ticket.id %>/delete" data-confirm="Delete this ticket and its transcript? This can't be undone.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-danger-ghost" type="submit"><%- include('partials/icon', { name: 'trash', size: 16 }) %> Delete ticket</button>
      </form>
    </section>
    <% } %>
  </aside>
</div>
<%- include('partials/foot') %>
