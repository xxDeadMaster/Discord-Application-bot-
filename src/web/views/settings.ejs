<%- include('partials/head') %>
<div class="page-head">
  <div class="page-head-text">
    <h1>Settings</h1>
    <p>Pick where everything goes. Channel and role lists come straight from your server.</p>
  </div>
</div>

<form method="post" action="/settings" class="stack">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <section class="card">
    <h2>Staff</h2>
    <%- include('partials/select', { name: 'staff_role_id', label: 'Staff role', list: opts.roles, value: settings.staff_role_id,
        help: 'People with this role can sign in here, review applications and see tickets. Server admins always can.' }) %>
  </section>

  <section class="card">
    <h2>Applications</h2>
    <div class="grid-2">
      <%- include('partials/select', { name: 'apply_channel_id', label: 'Applications channel', list: opts.textChannels, value: settings.apply_channel_id,
          help: 'Where the application panel (the dropdown) is posted.' }) %>
      <%- include('partials/select', { name: 'submissions_channel_id', label: 'Submissions channel', list: opts.textChannels, value: settings.submissions_channel_id,
          help: 'Where finished applications go for staff. Each role can override this.' }) %>
    </div>
    <div class="field">
      <label for="apply_panel_title">Panel title</label>
      <input id="apply_panel_title" name="apply_panel_title" maxlength="200" value="<%= settings.apply_panel_title %>">
    </div>
    <div class="field">
      <label for="apply_panel_description">Panel message</label>
      <textarea id="apply_panel_description" name="apply_panel_description" rows="3" maxlength="2000"><%= settings.apply_panel_description %></textarea>
    </div>
    <div class="field field-short">
      <label for="apply_cooldown_days">Days before someone can reapply after a denial</label>
      <input id="apply_cooldown_days" name="apply_cooldown_days" type="number" min="0" max="365" value="<%= settings.apply_cooldown_days %>">
      <p class="help">Set to 0 for no wait.</p>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>Who can't apply</h2>
      <span class="muted small"><span data-blocked-count><%= (settings.blocked_role_ids || []).length %></span> blocked</span>
    </div>
    <p class="muted small">Members with any of these roles are turned away when they try to apply. Already-submitted applications are not affected.</p>
    <div class="search" style="max-width: none; margin-bottom: 10px;">
      <%- include('partials/icon', { name: 'search', size: 16 }) %>
      <label class="sr" for="role-filter">Filter roles</label>
      <input id="role-filter" placeholder="Filter roles" data-filter-target="blocked-roles">
    </div>
    <div class="check-list" id="blocked-roles">
      <% const blocked = settings.blocked_role_ids || []; opts.roles.slice().sort((a, b) => blocked.includes(b.id) - blocked.includes(a.id)).forEach(r => { %>
        <label class="check-item" data-filter-text="<%= r.name.toLowerCase() %>">
          <input type="checkbox" name="blocked_role_ids" value="<%= r.id %>" <%= blocked.includes(r.id) ? 'checked' : '' %>>
          <span><%= r.name %></span>
        </label>
      <% }) %>
    </div>
  </section>

  <section class="card">
    <h2>Interviews</h2>
    <%- include('partials/select', { name: 'interview_category_id', label: 'Category for interview voice channels', list: opts.categories, value: settings.interview_category_id,
        emptyLabel: 'Same as tickets', help: 'Temporary voice channels made by the Interview button go here and delete themselves when everyone leaves.' }) %>
  </section>

  <section class="card">
    <h2>Timezone</h2>
    <div class="field field-short" style="max-width: 420px;">
      <label for="timezone">Timezone for application schedules</label>
      <select id="timezone" name="timezone">
        <% timezones.forEach(z => { %><option value="<%= z %>" <%= z === settings.timezone ? 'selected' : '' %>><%= z.replace(/_/g, ' ') %></option><% }) %>
      </select>
      <p class="help">Open and close times you set on the Applications page use this timezone.</p>
    </div>
  </section>

  <section class="card">
    <h2>Tickets</h2>
    <div class="grid-2">
      <%- include('partials/select', { name: 'ticket_channel_id', label: 'Open-a-ticket channel', list: opts.textChannels, value: settings.ticket_channel_id,
          help: 'Where the "Open a ticket" button is posted.' }) %>
      <%- include('partials/select', { name: 'ticket_category_id', label: 'Category for ticket channels', list: opts.categories, value: settings.ticket_category_id,
          emptyLabel: 'No category (top of the list)', help: 'New ticket channels are created inside this category.' }) %>
      <%- include('partials/select', { name: 'ticket_log_channel_id', label: 'Ticket log channel', list: opts.textChannels, value: settings.ticket_log_channel_id,
          help: 'Closed tickets are posted here with a transcript file. Keep it staff-only.' }) %>
    </div>
    <div class="field">
      <label for="ticket_panel_title">Panel title</label>
      <input id="ticket_panel_title" name="ticket_panel_title" maxlength="200" value="<%= settings.ticket_panel_title %>">
    </div>
    <div class="field">
      <label for="ticket_panel_description">Panel message</label>
      <textarea id="ticket_panel_description" name="ticket_panel_description" rows="3" maxlength="2000"><%= settings.ticket_panel_description %></textarea>
    </div>
  </section>

  <div class="actions sticky-actions">
    <button class="btn btn-primary" type="submit"><%- include('partials/icon', { name: 'check', size: 16 }) %> Save settings</button>
  </div>
</form>

<section class="card" id="panels">
  <h2>Panels</h2>
  <p class="muted small">Posts the panel in its channel, or updates the one already there. Application panels also update on their own when you change roles.</p>
  <div class="panel-actions">
    <form method="post" action="/settings/panel/apply">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn" type="submit"><%- include('partials/icon', { name: 'send', size: 16 }) %> Post or update application panel</button>
    </form>
    <form method="post" action="/settings/panel/ticket">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn" type="submit"><%- include('partials/icon', { name: 'send', size: 16 }) %> Post or update ticket panel</button>
    </form>
  </div>
</section>
<%- include('partials/foot') %>
