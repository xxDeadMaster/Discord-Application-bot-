<%- include('partials/head') %>
<%
  const srv = typeof server !== 'undefined' && server ? server : { name: 'Server', members: 0 };
  const online = typeof botOnline !== 'undefined' ? botOnline : true;
  const fmt = (n) => Number(n || 0).toLocaleString('en-US');
  const plural = (n, word) => `${word}${n == 1 ? '' : 's'}`;
  const ago = (d) => {
    const s = Math.max(0, (Date.now() - new Date(d).getTime()) / 1000);
    if (s < 60) return 'just now';
    if (s < 3600) return `${Math.floor(s / 60)}m ago`;
    if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
    return `${Math.floor(s / 86400)}d ago`;
  };
  // Managers-only pages: other staff see the row without a link
  const canOpen = (href) => isManager || !['/moderation', '/strikes', '/giveaways', '/polls'].includes(href);
  const MOD = { warn: 'Warned', timeout: 'Timed out', untimeout: 'Timeout removed', kick: 'Kicked', ban: 'Banned', unban: 'Unbanned' };
  const KINDS = {
    application: { icon: 'inbox', tone: 'blue', tag: 'Application',
      title: (a) => (a.status === 'accepted' ? 'Application accepted' : a.status === 'denied' ? 'Application denied' : 'New application'),
      sub: (a) => [a.who, `Applied for ${a.what}`] },
    ticket: { icon: 'ticket', tone: 'green', tag: 'Ticket', title: (a) => (a.status === 'open' ? 'Ticket opened' : 'Ticket closed'), sub: (a) => [a.who, a.what] },
    moderation: { icon: 'shield', tone: 'red', tag: 'Moderation', title: () => 'Member moderated', sub: (a) => [a.who, `${MOD[a.what] || a.what}${a.status ? ` by ${a.status}` : ''}`] },
    giveaway: { icon: 'gift', tone: 'purple', tag: 'Giveaway', title: (a) => (a.status === 'ended' ? 'Giveaway ended' : a.status === 'cancelled' ? 'Giveaway cancelled' : 'Giveaway started'), sub: (a) => [a.what, a.who ? `by ${a.who}` : ''] },
    poll: { icon: 'poll', tone: 'pink', tag: 'Poll', title: (a) => (a.status === 'ended' ? 'Poll ended' : 'Poll created'), sub: (a) => [a.what, a.who ? `by ${a.who}` : ''] },
    loa: { icon: 'calendar', tone: 'orange', tag: 'Leave', title: () => 'Leave of absence', sub: (a) => [a.who, a.what] },
    strike: { icon: 'alert', tone: 'red', tag: 'Strike', title: () => 'Strike given', sub: (a) => [a.who, a.what] },
  };
  const kindsHere = [...new Set(activity.map((a) => a.kind))];
  const SHOW = 7;
  const pending = [
    { n: counts.pending, title: 'Applications to review', sub: 'Oldest first', href: '/review', icon: 'inbox', tone: 'blue' },
    { n: todo.need_my_vote, title: 'Need your vote', sub: 'Applications you haven\'t voted on', href: '/submissions?status=pending', icon: 'check', tone: 'purple' },
    { n: todo.unclaimed, title: 'Tickets to respond to', sub: 'Open and not claimed yet', href: '/tickets?status=open', icon: 'ticket', tone: 'green' },
    { n: todo.my_tickets, title: 'Your claimed tickets', sub: 'Still open', href: '/tickets?status=open', icon: 'ticket', tone: 'green' },
    { n: todo.giveaways_ended, title: 'Giveaways ended', sub: 'Check winners, reroll if needed', href: '/giveaways', icon: 'gift', tone: 'purple' },
    { n: todo.polls_active, title: 'Polls running', sub: 'Active community polls', href: '/polls', icon: 'poll', tone: 'pink' },
    isAdmin && setupLeft ? { n: `${setupTotal - setupLeft}/${setupTotal}`, title: 'Finish setting up', sub: `${setupLeft} ${plural(setupLeft, 'step')} left`, href: '/settings', icon: 'settings', tone: 'orange' } : null,
  ].filter((p) => p && p.n && p.n !== '0');
  const quick = [
    isAdmin && { href: '/applications', icon: 'list', tone: 'blue', title: 'Create application', sub: 'Build a new application' },
    isManager && { href: '/ticket-types', icon: 'ticket', tone: 'green', title: 'Ticket settings', sub: 'Types, questions and panel' },
    isManager && { href: '/giveaways', icon: 'gift', tone: 'purple', title: 'Start giveaway', sub: 'Engage your community' },
    isAdmin && { href: '/role-menus', icon: 'users', tone: 'blue', title: 'Manage roles', sub: 'Configure role buttons' },
    isAdmin && { href: '/stats', icon: 'hash', tone: 'green', title: 'Server stats', sub: 'Counter channels' },
    !isManager && { href: '/submissions', icon: 'inbox', tone: 'blue', title: 'Applications', sub: 'Read and vote' },
    !isManager && { href: '/tickets', icon: 'ticket', tone: 'green', title: 'Tickets', sub: 'Help members' },
    !isManager && { href: '/loa', icon: 'calendar', tone: 'orange', title: myLoa ? 'My leave' : 'Request leave', sub: 'Going away for a while?' },
  ].filter(Boolean).slice(0, 5);
  const delta = (now, prev) => (prev == null ? null : now - prev);
  const statCards = [
    { n: counts.pending, label: 'Pending applications', href: '/review', icon: 'inbox', tone: 'blue', d: delta(todo.apps_week, todo.apps_prev), hint: 'new this week vs last' },
    { n: counts.open_tickets, label: 'Open tickets', href: '/tickets?status=open', icon: 'ticket', tone: 'green', d: delta(todo.tickets_week, todo.tickets_prev), hint: 'opened this week vs last' },
    { n: todo.mod_week, label: 'Mod actions (7 days)', href: isManager ? '/moderation' : '/staff', icon: 'shield', tone: 'red', d: delta(todo.mod_week, todo.mod_prev), hint: 'vs the week before' },
    { n: numbers.members, label: 'Total members', href: isAdmin ? '/stats' : '/', icon: 'users', tone: 'purple', d: delta(numbers.members, weekAgo?.members), hint: 'this week' },
  ];
  // Server overview tiles (the chart itself is drawn in the browser from the same data)
  const METRICS = [
    ['members', 'Members', '#3D8BFF'], ['humans', 'People', '#9B6DFF'], ['bots', 'Bots', '#FF9F43'],
    ['channels', 'Channels', '#55D98A'], ['roles', 'Roles', '#FF6FAE'], ['boosts', 'Boosts', '#FFD447'],
  ];
  const s7 = series.slice(-7);
  const firstOf7 = s7[0], lastPt = series[series.length - 1];
  const memDelta = s7.length > 1 ? lastPt.members - firstOf7.members : null;
  const arrow = (d) => (d > 0 ? '↑' : d < 0 ? '↓' : '');
%>
<div class="ov">
  <div class="ov-main">
    <section class="ov-hero">
      <img class="ov-hero-logo" src="/static/orbit-logo.png" alt="" width="72" height="72">
      <div class="ov-hero-text">
        <h1>Welcome back, <%= user.name %>!</h1>
        <p>Here's what's happening with your server today.</p>
        <div class="ov-chips">
          <span class="ov-chip"><%- include('partials/icon', { name: 'server', size: 15 }) %><span class="ov-chip-clip"><%= srv.name %></span></span>
          <span class="ov-chip"><%- include('partials/icon', { name: 'users', size: 15 }) %><%= fmt(numbers.members) %> <%= plural(numbers.members, 'Member') %></span>
          <span class="ov-chip"><span class="dot <%= online ? 'on' : 'off' %>"></span><%= online ? 'Online' : 'Offline' %></span>
          <% if (myLoa) { %><a class="ov-chip" href="/loa"><%= myLoa.started ? `🌴 On leave until ${myLoa.until}` : `📅 Leave starts ${myLoa.from}` %></a><% } %>
        </div>
      </div>
      <div class="ov-hero-side">
        <% if (counts.pending) { %>
          <p>You have <b><%= counts.pending %></b> <%= plural(counts.pending, 'application') %> waiting.</p>
          <a class="btn btn-primary" href="/review">Review now <%- include('partials/icon', { name: 'chevronRight', size: 16 }) %></a>
        <% } else if (todo.unclaimed) { %>
          <p><b><%= todo.unclaimed %></b> <%= plural(todo.unclaimed, 'ticket') %> need<%= todo.unclaimed == 1 ? 's' : '' %> someone.</p>
          <a class="btn btn-primary" href="/tickets?status=open">Open tickets <%- include('partials/icon', { name: 'chevronRight', size: 16 }) %></a>
        <% } else { %>
          <p>Nothing is waiting on staff. Orbit handles the rest.</p>
          <span class="ov-done"><%- include('partials/icon', { name: 'check', size: 16 }) %>All caught up</span>
        <% } %>
      </div>
    </section>

    <section class="ov-stats">
      <% statCards.forEach(c => { %>
        <a class="ov-stat" href="<%= c.href %>">
          <span class="ov-stat-icon solid-<%= c.tone %>"><%- include('partials/icon', { name: c.icon, size: 24 }) %></span>
          <span class="ov-stat-body">
            <span class="ov-stat-num"><%= fmt(c.n) %></span>
            <span class="ov-stat-label"><%= c.label %></span>
            <span class="ov-stat-view">View →</span>
          </span>
          <% if (c.d) { %><span class="ov-delta <%= c.d > 0 ? 'up' : 'down' %>" title="<%= c.d > 0 ? '+' : '' %><%= c.d %> <%= c.hint %>"><%= arrow(c.d) %> <%= fmt(Math.abs(c.d)) %></span><% } %>
        </a>
      <% }) %>
    </section>

    <div class="ov-pair">
      <section class="ov-card">
        <div class="ov-card-head">
          <span class="ov-head-icon"><%- include('partials/icon', { name: 'list', size: 22 }) %></span>
          <div><h2>Recent activity</h2><p>Latest events across your server.</p></div>
          <% if (kindsHere.length > 1) { %>
            <select class="ov-filter" data-activity-filter aria-label="Filter activity">
              <option value="all">All activity</option>
              <% kindsHere.forEach(k => { %><option value="<%= k %>"><%= KINDS[k].tag %></option><% }) %>
            </select>
          <% } %>
        </div>
        <% if (!activity.length) { %>
          <p class="empty-row">Nothing yet. Applications, tickets, giveaways and mod actions show up here.</p>
        <% } else { %>
          <ul class="ov-feed" data-activity-list data-show="<%= SHOW %>">
            <% activity.forEach((a, i) => { const k = KINDS[a.kind]; const [s1, s2] = k.sub(a); const link = canOpen(a.href); %>
              <li data-kind="<%= a.kind %>" <%= i >= SHOW ? 'hidden' : '' %>>
                <% if (link) { %><a class="ov-feed-row" href="<%= a.href %>"><% } else { %><div class="ov-feed-row"><% } %>
                  <span class="ov-round tone-<%= k.tone %>"><%- include('partials/icon', { name: k.icon, size: 18 }) %></span>
                  <span class="ov-feed-text">
                    <strong><%= k.title(a) %></strong>
                    <span><b><%= s1 || '' %></b><% if (s2) { %><i><%= s2 %></i><% } %></span>
                  </span>
                  <span class="ov-time" title="<%= new Date(a.at).toISOString() %>"><%= ago(a.at) %></span>
                  <span class="ov-tag tone-<%= k.tone %>"><%= k.tag %></span>
                <%- link ? '</a>' : '</div>' %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="ov-card">
        <div class="ov-card-head">
          <span class="ov-head-icon"><%- include('partials/icon', { name: 'clock', size: 22 }) %></span>
          <div><h2>Pending actions</h2><p>Items that need your attention.</p></div>
        </div>
        <% if (!pending.length) { %>
          <div class="ov-empty"><span class="ov-round tone-green"><%- include('partials/icon', { name: 'check', size: 20 }) %></span><p>Nothing is waiting on staff right now. 🎉</p></div>
        <% } else { %>
          <ul class="ov-list">
            <% pending.forEach(p => { %>
              <li><a class="ov-list-row" href="<%= canOpen(p.href) ? p.href : '/' %>">
                <span class="ov-square solid-<%= p.tone %>"><%- include('partials/icon', { name: p.icon, size: 18 }) %></span>
                <span class="ov-list-text"><strong><%= p.title %></strong><span><%= p.sub %></span></span>
                <span class="ov-count"><%= typeof p.n === 'number' ? fmt(p.n) : p.n %></span>
                <%- include('partials/icon', { name: 'chevronRight', size: 16 }) %>
              </a></li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </div>
  </div>

  <aside class="ov-rail">
    <section class="ov-card">
      <div class="ov-card-head">
        <span class="ov-head-icon accent"><%- include('partials/icon', { name: 'bolt', size: 22 }) %></span>
        <div><h2>Quick actions</h2><p>Jump to the most used features.</p></div>
      </div>
      <ul class="ov-list ov-quick">
        <% quick.forEach(q => { %>
          <li><a class="ov-list-row" href="<%= q.href %>">
            <span class="ov-square big solid-<%= q.tone %>"><%- include('partials/icon', { name: q.icon, size: 20 }) %></span>
            <span class="ov-list-text"><strong><%= q.title %></strong><span><%= q.sub %></span></span>
            <%- include('partials/icon', { name: 'chevronRight', size: 18 }) %>
          </a></li>
        <% }) %>
      </ul>
    </section>

    <section class="ov-card so" data-server-overview>
      <div class="ov-card-head so-head">
        <span class="ov-head-icon accent"><%- include('partials/icon', { name: 'activity', size: 22 }) %></span>
        <div><h2>Server overview</h2></div>
      </div>
      <div class="so-hero">
        <span class="so-big" data-so-big><%= fmt(lastPt.members) %></span>
        <span class="so-chg <%= memDelta > 0 ? 'up' : memDelta < 0 ? 'down' : 'flat' %>" data-so-chg><%= memDelta ? `${arrow(memDelta)} ${fmt(Math.abs(memDelta))}` : '' %></span>
        <div class="so-range" role="group" aria-label="Chart range">
          <button type="button" class="on" data-range="7">7d</button>
          <button type="button" data-range="30">30d</button>
        </div>
      </div>
      <div class="so-sub" data-so-sub>Members<%= memDelta == null ? '' : ` · ${memDelta > 0 ? '+' : ''}${memDelta || 'no change'} in the last 7 days` %></div>
      <div class="so-chart" data-so-chart>
        <svg preserveAspectRatio="none" aria-hidden="true"></svg>
        <div class="so-tip" role="status"></div>
        <% if (series.length < 2) { %><p class="so-wait">Collecting data. The chart fills in as Orbit saves a point each day, so check back in a few days.</p><% } %>
      </div>
      <div class="so-axis"><span data-so-from></span><span data-so-to></span></div>
      <div class="so-tiles">
        <% METRICS.forEach(([key, label, color], i) => { const d = s7.length > 1 ? lastPt[key] - firstOf7[key] : 0; %>
          <button type="button" class="so-tile <%= i === 0 ? 'on' : '' %>" data-metric="<%= key %>" style="--c: <%= color %>" aria-pressed="<%= i === 0 %>">
            <span class="so-t"><i></i><%= label %></span>
            <span class="so-n"><%= fmt(lastPt[key]) %></span>
            <span class="so-d <%= d > 0 ? 'up' : d < 0 ? 'down' : 'flat' %>"><%= d ? `${arrow(d)} ${fmt(Math.abs(d))}` : '—' %></span>
          </button>
        <% }) %>
      </div>
      <script type="application/json" data-so-data><%- JSON.stringify(series).replace(/</g, '\\u003c') %></script>
    </section>
  </aside>
</div>
<%- include('partials/foot') %>
